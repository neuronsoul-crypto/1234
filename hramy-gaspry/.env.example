# База данных PostgreSQL
DATABASE_URL=postgres://hramy:hramy@localhost:5432/hramy_gaspry
# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=
# Адрес сайта без слэша на конце
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Яндекс.Карты (JS API) и Яндекс.Метрика
