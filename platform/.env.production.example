# Продакшн-окружение для tavrida-osmotr.ru/aifaces. Скопировать в .env на сервере,
# заполнить реальными значениями. Не коммитить заполненный файл.

DATABASE_URL="postgresql://aifaces:CHANGE_ME@127.0.0.1:5432/aifaces"
SESSION_SECRET="CHANGE_ME_RANDOM_64_HEX" # сгенерировать: openssl rand -hex 32
DEPLOY_BASE_PATH="/aifaces"
NODE_ENV="production"

# --- Провайдеры (см. docs/TZ.md раздел 8) — на первом деплое остаются стабами ---
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
KYC_PROVIDER="visionlabs"
ESIGN_PROVIDER="sbis"
